            FILTER (str(?Terminal) != str(?Terminal2))
        }
    }
    UNION
    {
        ?ACDCConverter
            a ?type .
        ?Terminal1 cim:Terminal.ConductingEquipment ?ACDCConverter .
        ?Terminal2 cim:Terminal.ConductingEquipment ?ACDCConverter .
        OPTIONAL { ?Terminal1 cim:ACDCTerminal.sequenceNumber ?seq1 }
        OPTIONAL { ?Terminal2 cim:ACDCTerminal.sequenceNumber ?seq2 }
        FILTER (bound(?seq1) && ?seq1 = "1" && bound(?seq2) && ?seq2 = "2"
            || !bound(?seq1) && !bound(?seq2) && str(?Terminal1) < str(?Terminal2))
    }
    ?ACDCConverter cim:IdentifiedObject.name ?name ;
        cim:ACDCConverter.ratedUdc ?ratedUdc ;
        cim:Equipment.EquipmentContainer ?DCConverterUnit .
    ?DCConverterUnit
        a cim:DCConverterUnit ;
        cim:IdentifiedObject.name ?unitName ;
        cim:DCConverterUnit.operationMode ?operationMode .
    ?DCTerminal1
        a cim:ACDCConverterDCTerminal ;
        cim:ACDCConverterDCTerminal.DCConductingEquipment ?ACDCConverter .
    OPTIONAL { ?DCTerminal1 cim:ACDCConverterDCTerminal.sequenceNumber ?dcseq1 }
    ?DCTerminal2
        a cim:ACDCConverterDCTerminal ;
        cim:ACDCConverterDCTerminal.DCConductingEquipment ?ACDCConverter .
    OPTIONAL { ?DCTerminal2 cim:ACDCConverterDCTerminal.sequenceNumber ?dcseq2 }
    FILTER (bound(?dcseq1) && ?dcseq1 = "1" && bound(?dcseq2) && ?dcseq2 = "2"
        || !bound(?dcseq1) && !bound(?dcseq2) && str(?DCTerminal1) < str(?DCTerminal2))
    VALUES ?type { cim:CsConverter cim:VsConverter }
    OPTIONAL {
        ?ACDCConverter cim:ACDCConverter.PccTerminal ?PccTerminal
    }
    OPTIONAL {
        ?ACDCConverter cim:VsConverter.CapabilityCurve ?ReactiveCapabilityCurve
    }
    OPTIONAL { ?ACDCConverter cim:ACDCConverter.idleLoss ?idleLoss }
    OPTIONAL { ?ACDCConverter cim:ACDCConverter.switchingLoss ?switchingLoss }
    OPTIONAL { ?ACDCConverter cim:ACDCConverter.resistiveLoss ?resistiveLoss }
}
}

